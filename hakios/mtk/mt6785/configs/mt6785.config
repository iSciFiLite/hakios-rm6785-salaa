# MT6785 maximum read-only bring-up profile for SALAA and Nemo.
CONFIG_SOC="mt6785"
# XNULOADER offers the six A55s and two performance cores by MPIDR affinity. Keep core 0 for the
# resident UEFI loader and start XNU on the big cluster; the firmware must implement PSCI CPU_ON.
CONFIG_CPUS=7
CONFIG_BOOTCPU=7
# CONFIG_CPUFREQ is not set
# UFSHCI read-only block service through UEFI, with xnusys selected as the Darwin root.
# The UEFI must expose UFS Block I/O and an xnusys partition must be provisioned first.
CONFIG_UFS=2
CONFIG_UFS_ROOT=y
CONFIG_HAKIOS_UFS=y
# Deliberately no write request: UFS_WRITE and VAR_STORE remain off.
# These defaults come from common_defconfig, but are for other devices. Do not build/start their
# hardware paths on MT6785 until this port has matching drivers and board data.
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_MIC is not set
# CONFIG_WIFI is not set
# CONFIG_HAPTIC is not set
# CONFIG_CAM is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
